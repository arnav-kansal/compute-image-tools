{
  "Name": "build-ubuntu-2004-from-iso",
  "Vars": {
    "installer_iso": {
      "Value": "gs://private-cloud-devel-artifacts/pren/bootstrapper.iso",
      "Description": "The Ubuntu 20.04 installer ISO to build from."
    },
    "build_date": {
      "Value": "${TIMESTAMP}",
      "Description": "Build datestamp used to version the image."
    },
    "publish_project": {
      "Value": "private-cloud-devel",
      "Description": "A project to publish the resulting image to."
    }
  },
  "Steps": {
    "build-ubuntu": {
      "Timeout": "60m",
      "IncludeWorkflow": {
        "Path": "./ubuntu-2004-from-iso/ubuntu_installer.wf.json",
        "Vars": {
          "ubuntu_release": "ubuntu-2004",
          "installer_iso": "${installer_iso}"
        }
      }
    },
    "create-image": {
      "CreateImages": [
        {
          "Name": "ubuntu-2004-v${build_date}",
          "SourceDisk": "ubuntu-install-disk",
          "Description": "Ubuntu, 20.04, x86_64 built on ${build_date}",
          "Family": "ubuntu-2004",
          "Project": "${publish_project}",
          "NoCleanup": true,
          "ExactName": true,
          "GuestOsFeatures": ["UEFI_COMPATIBLE", "VIRTIO_SCSI_MULTIQUEUE", "GVNIC"]
        }
      ]
    }
  },
  "Dependencies": {
    "create-image": ["build-ubuntu"]
  }
}
